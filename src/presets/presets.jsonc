{
  // 内置模型策展清单（只读，随包分发）。
  // ⚠ 这是随包分发的内置模型配置：修改会随插件升级/重装被覆盖。
  //   仅用于本地开发调试；正式自定义请使用设置面板中的「自定义模型」。
  // 字段说明：
  //   - modelUrl   : .model3.json URL（内置清单使用现代格式），模型一律 URL 直载，不随包分发模型文件
  //   - spatialTap : 可选空间回退分区覆盖
  //   - animationMap: 可选状态/互动部位动画映射（动作组名列表）
  "version": 3,
  "presets": [
    {
      "id": "hiyori",
      "name": "Hiyori（百瀬ひより）",
      "author": "Live2D Inc.",
      "modelUrl": "https://cdn.jsdelivr.net/gh/Live2D/CubismWebSamples@develop/Samples/Resources/Hiyori/Hiyori.model3.json",
      "license": {
        "type": "Live2D 示例模型条款（免费商用可，需标注著作权）",
        "url": "https://www.live2d.com/eula/live2d-sample-model-terms_cn.html"
      },
      "cubism": 4,
      "status": "annotated",
      // Hiyori 的空间回退覆盖：居中五矩形（spec §4）
      "spatialTap": {
        "headMaxNy": 0.30,
        "legMinNy": 0.57,
        "armMinNy": 0.28,
        "headMinNx": 0.32,
        "headMaxNx": 0.68,
        "bodyMinNx": 0.36,
        "bodyMaxNx": 0.64,
        "armLeftMinNx": 0.18,
        "armRightMaxNx": 0.82
