{
  "id": "ccgui.live2d-pets",
  "name": "Live2D Pets",
  "version": "1.0.10",
  "minAppVersion": "1.0.4",
  "sdkVersion": ">=0.3.21",
  "author": "MurasameCyan",
  "description": "让 AI 有个鲜活的伙伴：在 CC GUI 内同步当前会话状态，支持触摸互动、个性台词、自定义 Live2D 模型与动作映射。",
  "repo": "MurasameCyan/ccgui-plugin-live2d-pets",
  "icon": "assets/icons/paw-print.svg",
  "screenshots": [
    "docs/media/hero.jpg"
  ],
  "keywords": [
    "live2d",
    "pet",
    "overlay",
    "cubism",
    "mascot"
  ],
  "tier": "js",
  "license": "MIT",
  "permissions": [
    "storage",
    "plugin.storage",
    "ui:settings-section",
    "ui:overlay",
    "ui:command",
    "session.lifecycle.read",
    "runtime.events.read",
    "events",
    "assets:bundle",
    "assets:directory",
    "network:cdn.jsdelivr.net"
  ]
}
